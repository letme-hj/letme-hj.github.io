<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | sort: 'date' | reverse %}
    {% if include.limit and site.announcements.limit %}
      {% assign news_limit = site.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    {% assign visible_count = site.announcements.visible | default: 5 %}
    {% assign should_scroll = false %}
    {% if include.limit and site.announcements.scrollable and news_size > visible_count and news_limit > visible_count %}
      {% assign should_scroll = true %}
    {% endif %}
    <div
      class="table-responsive{% if should_scroll %} news-scrollable{% endif %}"
      {% if should_scroll %}
        data-visible-rows="{{ visible_count }}"
        style="max-height: 15rem; overflow-y: auto;"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if should_scroll %}
      <script>
        (function () {
          function adjustNewsHeight() {
            document.querySelectorAll('.news-scrollable').forEach(function (el) {
              var visibleRows = parseInt(el.getAttribute('data-visible-rows'), 10) || 5;
              var rows = el.querySelectorAll('tbody tr, tr');
              if (rows.length > visibleRows) {
                var height = 0;
                for (var i = 0; i < visibleRows; i++) {
                  height += rows[i].getBoundingClientRect().height;
                }
                if (height > 0) {
                  el.style.maxHeight = Math.ceil(height) + 'px';
                }
              }
            });
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', adjustNewsHeight);
          } else {
            adjustNewsHeight();
          }
          window.addEventListener('resize', adjustNewsHeight);
        })();
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
